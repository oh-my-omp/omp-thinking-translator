{
	"name": "omp-thinking-translator",
	"version": "1.0.1",
	"description": "omp extension for translating visible assistant thinking blocks.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-thinking-translator.git"
	},
	"homepage": "https://github.com/oh-my-omp/omp-thinking-translator#readme",
	"bugs": {
		"url": "https://github.com/oh-my-omp/omp-thinking-translator/issues"
	},
	"private": true,
	"keywords": [
		"omp",
		"omp-extension",
		"thinking",
		"translation"
	],
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "bun test"
	},
	"files": [
		"index.ts",
		"src",
		"omomp-shared",
		"README.md",
		"README.zh-CN.md",
		"CHANGELOG.md"
	],
	"omp": {
		"extensions": [
			"./index.ts"
		],
		"settings": {
			"enabled": {
				"type": "boolean",
				"default": true,
				"description": "Translate visible thinking lines; translation also needs the @omp-thinking-translator model role bound in /model"
			},
			"targetLanguage": {
				"type": "string",
				"default": "Simplified Chinese",
				"description": "Language the thinking lines are translated into"
			},
			"lateNotify": {
				"type": "boolean",
				"default": false,
				"description": "Show translations that finish after their thinking box stopped being redrawn as notification rows"
			}
		}
	},
	"omomp": {
		"changelog": "CHANGELOG.md"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/pi-ai": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-tui": "latest",
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
